#!/bin/bash
# scaffold a new leetcode project: ./init <problem-name>

set -euo pipefail

if [ $# -ne 1 ]; then
    echo "usage: ./init <problem-name>" >&2
    exit 1
fi

name=$1
pkg=${name//-/_}
cd "$(dirname "$0")/leetcode"

uv init --lib --no-readme --no-workspace --vcs none --no-pin-python "$name"
cd "$name"
rm "src/$pkg/py.typed"
sed -i.bak '/^description = /d' pyproject.toml && rm pyproject.toml.bak
cat >> pyproject.toml <<'TOML'

[tool.pytest.ini_options]
testpaths = ["tests"]
TOML
mkdir tests
touch "src/$pkg/solution.py" tests/test_solution.py
uv add --dev pytest
uv add --editable ../../dsa

# keep the problem list in leetcode/README.md sorted
{
    grep -v '^- ' ../README.md
    { grep '^- ' ../README.md; echo "- $name"; } | sort
} > ../README.md.new
mv ../README.md.new ../README.md

echo "created: leetcode/$name"
